{
  "manifest_version": 3,
  "name": "Fitdle Quickplay",
  "version": "1.0.0",
  "description": "Guess the five-to-nine letter exercise in six tries. A new one every day.",
  "action": {
    "default_popup": "play.html",
    "default_title": "Fitdle"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://*/*"
  ]
}
