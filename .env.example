# ─────────────────────────────────────────────────────────────────────────────
# Cloud sync (optional).
#
# Fitdle runs fully without these — progress just stays on one device and the
# account panel says so. Fill them in to turn on real accounts and cross-device
# streak sync.
#
#   1. Create a project at https://supabase.com
#   2. Settings -> API: copy the Project URL and the anon/public key below
#   3. SQL Editor: run supabase/schema.sql
#   4. Copy this file to .env.local and restart `npm run dev`
#
# Both values are safe to expose in the client bundle. Row-level security in
# schema.sql is what protects the data, not the key.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Public site URL, appended to every shared result. Defaults to
# https://fitdle.app — set this to wherever you actually deploy, or the link in
# people's shares points nowhere.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=
