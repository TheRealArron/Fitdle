# ─────────────────────────────────────────────────────────────────────────────
# Cloud sync (optional).
#
# Fitdle runs fully without these - progress just stays on one device and the
# account panel says so. Fill them in to turn on real accounts and cross-device
# streak sync.
#
#   1. Create a project at https://supabase.com
#   2. Settings -> API: copy the Project URL and the anon/public key below
#   3. SQL Editor: run supabase/schema.sql
#   4. Copy this file to .env.local and restart `npm run dev`
#
# Both values are safe to expose in the client bundle. Row-level security in
# schema.sql is what protects the data, not the key.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Public site URL, appended to every shared result. Defaults to
# https://fitdle.app - set this to wherever you actually deploy, or the link in
# people's shares points nowhere.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Server-only. Signs the game-state tokens that make guesses unforgeable.
# REQUIRED - the API routes refuse to start without it, because an unsigned
# token looks like a guarantee and is not one.
#
#   openssl rand -base64 48
#
# Never prefix this with NEXT_PUBLIC_. It must not reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

FITDLE_SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Where the client sends guesses. Blank = same origin, which is right for the
# web app.
#
# The Chrome extension MUST set this: a static export has no server of its own,
# so it calls your deployment. That is the trade for keeping the answer secret -
# the extension needs a network connection to play the daily. Practice mode
# still works without one.
#
#   NEXT_PUBLIC_API_URL=https://fitdle.vercel.app
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Server-only. Powers the post-round form coach.
#
# OPTIONAL. Without it the coach box hides itself and everything else works
# unchanged - the no-equipment substitutions come from the catalogue, not the
# model, so a player with no gym is served whether or not this is set.
#
#   https://console.anthropic.com/settings/keys
#
# Costs money per question. Rate limited to 10/min per IP, capped at 400
# characters, and only reachable once the round is over.
# Never prefix this with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Server-only. Lets the API write authoritative streaks.
#
# ⚠ THIS KEY BYPASSES ROW LEVEL SECURITY ENTIRELY. Anyone holding it can read
# and write every row in your database. Never prefix it with NEXT_PUBLIC_ -
# that would inline it into every visitor's JavaScript bundle.
#
#   Supabase → Settings → API → service_role  (NOT the anon/publishable key)
#
# Optional. Without it, streaks stay on the device and the leaderboard has
# nothing trustworthy to rank - the game itself plays normally.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Hard daily ceiling on model calls, across all users. Default 500.
#
# Per-IP rate limiting caps how fast ONE person can ask; it does nothing about
# what everybody costs together. 1,000 players asking three questions each sits
# inside every per-IP limit and is still an unbounded bill.
#
# When the budget is gone the AI features say so and switch off until UTC
# midnight. The game, drill, leaderboard and home substitutions are unaffected.
#
# In-memory and per-instance, so treat Anthropic Console spend limits as the
# real backstop and this as what degrades gracefully before you reach them.
# ─────────────────────────────────────────────────────────────────────────────

AI_DAILY_BUDGET=500

# ─────────────────────────────────────────────────────────────────────────────
# The date puzzle #1 lands on. Set this to your deploy date.
# Changing it later renumbers every puzzle, including ones already shared.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_LAUNCH_DATE=
