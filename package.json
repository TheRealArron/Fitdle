{
  "name": "fitdle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import ./tests/loader.mjs --test tests/*.test.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "cloud:check": "node scripts/cloud-check.mjs",
    "check:bundle": "node --conditions=react-server --import ./tests/loader.mjs scripts/check-bundle.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:bundle && npm run check:size && npm run check:contrast && npm run smoke",
    "check:size": "node scripts/check-size.mjs",
    "coach:probe": "node --conditions=react-server --import ./tests/loader.mjs scripts/coach-probe.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/supabase-js": "^2.111.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
